{
  "info": {
    "name": "АВТОБАЗА — API",
    "description": "Запустите сайт локально. Сначала получите сессию. Cookie сохраняет Postman, токен обновляют тестовые скрипты. Для создания заявки задайте переменные carId/from/to. Изменяющие запросы действительно записывают данные в текущую БД.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "csrfToken",
      "value": ""
    },
    {
      "key": "carId",
      "value": ""
    },
    {
      "key": "rentalId",
      "value": ""
    },
    {
      "key": "from",
      "value": ""
    },
    {
      "key": "to",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 — Сессия и CSRF (выполнить первой)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/auth/session",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "session"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "if (data.csrfToken) pm.collectionVariables.set(\"csrfToken\", data.csrfToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 — Вход администратора (учебный аккаунт)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@avtobaza.test\",\n  \"password\": \"Avtobaza2026!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "if (data.csrfToken) pm.collectionVariables.set(\"csrfToken\", data.csrfToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 — Каталог",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/cars",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "cars"
          ]
        }
      }
    },
    {
      "name": "04 — Расчёт: заполните carId и актуальные даты",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/quote",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "quote"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"carId\": \"{{carId}}\",\n  \"from\": \"{{from}}\",\n  \"to\": \"{{to}}\",\n  \"extras\": {\n    \"insurance\": true,\n    \"childSeat\": false\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "05 — Создать заявку",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/rentals",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "rentals"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"carId\": \"{{carId}}\",\n  \"from\": \"{{from}}\",\n  \"to\": \"{{to}}\",\n  \"extras\": {\n    \"insurance\": true,\n    \"childSeat\": false\n  },\n  \"comment\": \"Заявка из Postman\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "06 — Свои заявки",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/rentals",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "rentals"
          ]
        }
      }
    },
    {
      "name": "07 — Обзор сотрудника",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/admin/overview",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "overview"
          ]
        }
      }
    },
    {
      "name": "08 — Подтвердить: заполните rentalId",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/rentals/{{rentalId}}/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "rentals",
            "{{rentalId}}",
            "status"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"confirmed\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "09 — История осмотров",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/admin/maintenance",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "maintenance"
          ]
        }
      }
    },
    {
      "name": "10 — Выход",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/logout",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "logout"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    }
  ]
}