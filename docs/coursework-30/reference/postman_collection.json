{
  "info": {
    "name": "NORDE automated API acceptance tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Only isolated local test database. Compact collection: registration, access and rental cancellation."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3001"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "if (pm.info.requestName === \"01 Health\" || !pm.collectionVariables.get(\"stamp\")) { const now=new Date();const from=new Date(now.getTime()+3*3600000).toISOString().slice(0,10);const to=new Date(from+\"T00:00:00Z\");to.setUTCDate(to.getUTCDate()+1);pm.collectionVariables.set(\"stamp\",String(Date.now()).slice(-7));pm.collectionVariables.set(\"from\",from);pm.collectionVariables.set(\"to\",to.toISOString().slice(0,10)); }"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "02 Session",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/auth/session"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "const d=pm.response.json();pm.collectionVariables.set(\"csrfToken\",d.csrfToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Catalog",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/cars"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "const c=pm.response.json().cars.find(c=>c.status===\"available\");pm.collectionVariables.set(\"carId\",c._id);pm.collectionVariables.set(\"mileage\",c.mileage);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Invalid dates",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/quote",
        "body": {
          "mode": "raw",
          "raw": "{\"carId\": \"{{carId}}\", \"from\": \"2026-02-30\", \"to\": \"2026-03-03\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\",()=>pm.response.to.have.status(400));",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "05 Quote",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/quote",
        "body": {
          "mode": "raw",
          "raw": "{\"carId\": \"{{carId}}\", \"from\": \"{{from}}\", \"to\": \"{{to}}\", \"extras\": {}}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "06 Missing consent",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Postman Client\", \"email\": \"postman{{stamp}}@example.test\", \"phone\": \"+79002223344\", \"password\": \"Postman2026!\", \"ageConfirmed\": true, \"licenseConfirmed\": true, \"drivingExperience\": 3, \"termsAccepted\": true, \"personalDataConsent\": false, \"legalVersion\": \"2026-11-23.1\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\",()=>pm.response.to.have.status(400));",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "07 Registration",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Postman Client\", \"email\": \"postman{{stamp}}@example.test\", \"phone\": \"+79002223344\", \"password\": \"Postman2026!\", \"ageConfirmed\": true, \"licenseConfirmed\": true, \"drivingExperience\": 3, \"termsAccepted\": true, \"personalDataConsent\": true, \"legalVersion\": \"2026-11-23.1\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\",()=>pm.response.to.have.status(201));",
              "const d=pm.response.json();pm.collectionVariables.set(\"csrfToken\",d.csrfToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Client cannot manage users",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/admin/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\",()=>pm.response.to.have.status(403));",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "09 Booking",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/rentals",
        "body": {
          "mode": "raw",
          "raw": "{\"carId\": \"{{carId}}\", \"from\": \"{{from}}\", \"to\": \"{{to}}\", \"extras\": {}}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\",()=>pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"rentalId\",pm.response.json().rental._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Client cannot confirm",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/rentals/{{rentalId}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\"status\": \"confirmed\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\",()=>pm.response.to.have.status(409));",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "11 Cancel",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/rentals/{{rentalId}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\"status\": \"cancelled\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "12 Logout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/auth/logout",
        "body": {
          "mode": "raw",
          "raw": "{}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "13 New session",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/auth/session"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "const d=pm.response.json();pm.collectionVariables.set(\"csrfToken\",d.csrfToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "14 Wrong password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"admin@avtobaza.test\", \"password\": \"Wrongpass2026!\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\",()=>pm.response.to.have.status(401));",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "15 Admin login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"admin@avtobaza.test\", \"password\": \"Avtobaza2026!\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "const d=pm.response.json();pm.collectionVariables.set(\"csrfToken\",d.csrfToken);"
            ]
          }
        }
      ]
    }
  ]
}