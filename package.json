{
  "name": "avtobaza",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client \"node --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "vite build",
    "start": "node server/index.js",
    "db:up": "docker compose up -d --wait mongo",
    "db:down": "docker compose down",
    "seed": "node scripts/seed.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:coverage": "node --experimental-test-coverage --test --test-concurrency=1 tests/*.test.js",
    "test:e2e": "playwright test",
    "test:load": "node scripts/load.js",
    "setup:env": "node scripts/init-env.js"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "connect-mongo": "^6.0.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.69.0",
    "mongoose": "^8.24.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^5.2.0",
    "autocannon": "^8.0.0",
    "concurrently": "^10.0.6",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "vite": "^7.3.7"
  }
}
